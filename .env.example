# ---- Runtime ----
NODE_ENV=development
PORT=8080

# ---- Postgres (you own this DB) ----
# Use a PgBouncer/pooled connection string in serverless (Vercel).
DATABASE_URL=postgres://user:pass@localhost:5432/paperplane

# ---- WhatsApp provider ----
# twofactor | meta | threesixty
WHATSAPP_PROVIDER=twofactor
# Shared secret you set; used for the webhook verification handshake.
WEBHOOK_VERIFY_TOKEN=paperplane-verify
# The single shared WhatsApp Business number, E.164 digits only (for wa.me/QR links).
WHATSAPP_BUSINESS_NUMBER=910000000000

# 2Factor WhatsApp Business API
TWOFACTOR_API_KEY=
TWOFACTOR_BASE_URL=https://api.2factor.in

# ---- Object storage (S3 ap-south-1 or DO Spaces BLR) for report files ----
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
# Set STORAGE_ENDPOINT for non-AWS S3-compatible stores (e.g. DO Spaces).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
